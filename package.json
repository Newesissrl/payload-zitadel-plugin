{
  "name": "@newesissrl/payload-zitadel-plugin",
  "version": "1.0.3",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": "https://github.com/Newesissrl/payload-zitadel-plugin.git",
  "author": "Newesis Srl",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "LICENSE",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "README.md"
  ],
  "scripts": {
    "version:show": "cat package.json | grep version",
    "dev": "tsc --watch",
    "build": "rimraf dist/ && yarn build:swc && yarn build:tsc && yarn build:components",
    "build:tsc": "tsc --p tsconfig.json",
    "build:components": "webpack --config webpack.components.config.js",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc",
    "test": "jest",
    "test:watch": "jest --watch",
    "serve:cov": "serve coverage -c ../serve.json",
    "lint": "eslint . --ext .ts",
    "push:cov": "yarn test && docker run -v $PWD:/code codacy/codacy-coverage-reporter report --coverage-reports /code/coverage/lcov.info"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "mzinga": "1.0.5"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.3",
    "@babel/plugin-transform-class-properties": "^8.0.1",
    "@babel/plugin-transform-nullish-coalescing-operator": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.1.2",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@mzinga/db-mongodb": "1.0.5",
    "@mzinga/richtext-slate": "1.0.5",
    "@parcel/transformer-typescript-types": "2.16.1",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.3",
    "@testing-library/jest-dom": "^8.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.7",
    "@types/passport": "1.0.17",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "babel-loader": "^10.0.0",
    "cliui": "^9.0.1",
    "css-loader": "^7.1.2",
    "eslint": "^10.15.0",
    "file-loader": "^6.2.0",
    "jest": "^30.2.0",
    "jest-fetch-mock": "^4.2.0",
    "mini-css-extract-plugin": "^2.9.0",
    "postcss-loader": "^8.2.0",
    "postcss-preset-env": "^11.6.3",
    "rimraf": "^6.1.2",
    "sass-loader": "^17.1.1",
    "serve": "^14.2.5",
    "string-width": "^9.0.0",
    "swc-loader": "^0.2.6",
    "ts-jest": "29.4.6",
    "ts-loader": "^9.4.2",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "url-loader": "^4.1.1",
    "webpack": "^5.103.0",
    "webpack-cli": "^7.3.1"
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.1",
    "cookie-parser": "^1.4.6",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mzinga",
    "plugin",
    "mzinga-plugin",
    "zitadel"
  ]
}
