{
  "name": "@newesissrl/payload-zitadel-plugin",
  "version": "1.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": "https://github.com/Newesissrl/payload-zitadel-plugin.git",
  "author": "Newesis Srl",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "LICENSE",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "README.md"
  ],
  "scripts": {
    "version:show": "cat package.json | grep version",
    "dev": "tsc --watch",
    "build": "rimraf dist/ && yarn build:swc && yarn build:tsc && yarn build:components",
    "build:tsc": "tsc --p tsconfig.json",
    "build:components": "webpack --config webpack.components.config.js",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "test": "jest",
    "test:watch": "jest --watch",
    "serve:cov": "serve coverage -c ../serve.json",
    "lint": "eslint .",
    "push:cov": "yarn test && docker run -v $PWD:/code codacy/codacy-coverage-reporter report --coverage-reports /code/coverage/lcov.info"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.6.0 || ^0.7.0",
    "pino": "^8.15.0 || ^9.0.0 || ^10.0.0"
  },
  "peerDependencies": {
    "cookie-parser": "^1.4.6",
    "mzinga": "^1.0.5",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-i18next": "^11.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mzinga/db-mongodb": "1.0.5",
    "@mzinga/richtext-slate": "1.0.5",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.11",
    "@types/passport": "1.0.17",
    "cookie-parser": "^1.4.7",
    "css-loader": "^7.1.5",
    "eslint": "^10.15.0",
    "file-loader": "^6.2.0",
    "globals": "^17.14.0",
    "i18next": "22.5.1",
    "jest": "^30.5.2",
    "jest-fetch-mock": "^4.2.0",
    "mini-css-extract-plugin": "^2.10.2",
    "mzinga": "1.0.5",
    "postcss": "^8.5.34",
    "postcss-loader": "^8.2.2",
    "postcss-preset-env": "^11.6.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "11.18.6",
    "rimraf": "^6.1.4",
    "sass-loader": "^17.1.1",
    "serve": "^14.2.8",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mzinga",
    "plugin",
    "mzinga-plugin",
    "zitadel"
  ]
}
